# Absolute paths are required when this file is loaded by systemd.
H3_ROOT=/home/ubuntu/minimax-h3-stack/minimax-studio-webui
H3_COMFY_ROOT=/home/ubuntu/minimax-h3-stack/ComfyUI
H3_ENGINE=comfyui
H3_HOST=0.0.0.0
H3_PORT=8193
# Built-in workflows are seeded into data/config.db on first start.
H3_COMFY_OUTPUT_DIR=/home/ubuntu/minimax-h3-stack/ComfyUI/output
H3_COMFY_POLL_SECONDS=2
H3_REMOTE_RECONNECT_SECONDS=120
H3_GPU_LABEL="MiniMax H3 FP8 / GPU 0 / RTX 4090"
H3_INCOGNITO_CODE=replace-with-a-random-secret
H3_API_KEY=
H3_MAX_UPLOAD_MB=512
CUDA_VISIBLE_DEVICES=0
